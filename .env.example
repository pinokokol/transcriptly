# transcriptly demo API configuration (server/ only; the CLI and MCP need none of this).

# Port the API listens on.
PORT=8787

# ASR engine for the hosted API: "groq" (default, fast, needs GROQ_API_KEY)
# or "local" (whisper-cli on this machine, no external calls).
ASR_ENGINE=groq

# Required when ASR_ENGINE=groq. Create one at https://console.groq.com
GROQ_API_KEY=

# Optional: Discord webhook that gets pinged on each waitlist signup.
# Signups are always appended to $DATA_DIR/waitlist.txt regardless.
DISCORD_WEBHOOK_URL=

# Comma-separated browser origins allowed via CORS (the demo site).
ALLOWED_ORIGINS=http://localhost:3000

# Where cached transcripts and server state live.
CACHE_DIR=server/.cache
DATA_DIR=server/.data

# Set to 1 only behind a reverse proxy that sanitizes X-Forwarded-For (Caddy does).
TRUST_PROXY=0

# Optional: route yt-dlp calls for YouTube sources through this proxy
# (residential proxies get around YouTube's datacenter-IP blocking).
# Other platforms and direct URLs never use it.
# Example: http://user:pass@proxy.example:8080
YOUTUBE_PROXY_URL=

# Local engine only: Whisper model name (file must exist in ~/.cache/transcriptly/models).
WHISPER_MODEL=small
