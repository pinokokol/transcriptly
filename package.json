{
  "name": "transcriptly",
  "version": "0.1.1",
  "description": "Transcripts for any video URL - CLI, MCP, REST, WebMCP",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:api": "bun --watch server/index.ts",
    "dev:web": "bun run --cwd web dev",
    "build": "bun build ./src/index.ts ./src/cli.ts --outdir ./dist --target=node && tsc -p tsconfig.build.json",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build && bun test"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "bin": {
    "transcriptly": "dist/cli.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "typescript": "7.0.2"
  }
}
